#!/usr/bin/python3
# omarchy:summary=Write Omarchy agents-panel records from ai-usagebar
# omarchy:args=[--write]
"""Turn `ai-usagebar usage --json` into Omarchy agents-panel records.

The Omarchy agents panel (omarchy.agents) draws whatever JSON records appear in
~/.local/state/omarchy/agents/usage/. This maps ai-usagebar's live quota data
into that schema for every vendor Omarchy does not already collect natively
(Command Code, Copilot, and any other ai-usagebar provider). Native vendors
(claude/codex/fireworks) are skipped so the richer built-in collectors keep
ownership of those tabs.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

NATIVE = {"anthropic": "claude", "openai": "codex", "fireworks": "fireworks"}
MONEY = re.compile(r"([^\d\s]+)\s*([\d,]+(?:\.\d+)?)")


def usage_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")
    return Path(base) / "omarchy" / "agents" / "usage"


def find_ai_usagebar() -> str | None:
    found = shutil.which("ai-usagebar")
    if found:
        return found
    for candidate in (
        Path.home() / ".local/share/mise/shims/ai-usagebar",
        Path("/usr/local/bin/ai-usagebar"),
        Path("/usr/bin/ai-usagebar"),
    ):
        if candidate.exists():
            return str(candidate)
    return None


def parse_amount(text: str):
    match = MONEY.search(str(text or ""))
    if not match:
        return None
    try:
        return float(match.group(2).replace(",", "")), match.group(1).strip()
    except ValueError:
        return None


def currency_code(symbol: str) -> str:
    return {"$": "USD", "€": "EUR", "£": "GBP", "¥": "JPY"}.get(symbol, "USD")


def build_limits(entry: dict) -> list:
    limits = []
    for metric in entry.get("metrics") or []:
        percent = metric.get("percent")
        if percent is None:
            continue
        try:
            fraction = max(0.0, min(1.0, float(percent) / 100.0))
        except (TypeError, ValueError):
            continue
        limits.append({
            "label": str(metric.get("label") or "Usage"),
            "percent": fraction,
            "resetsAt": str(metric.get("reset_at") or ""),
        })
    return limits


def build_balance(entry: dict):
    spent = funded = remaining = None
    symbol = "$"
    for metric in entry.get("metrics") or []:
        detail = str(metric.get("detail") or "")
        if " of " not in detail:
            continue
        left, _, right = detail.partition(" of ")
        first = parse_amount(left)
        second = parse_amount(right)
        if second and second[0] > 0 and second[0] >= (funded or 0):
            funded = second[0]
            spent = first[0] if first else 0.0
            symbol = second[1] or symbol
    for section in entry.get("sections") or []:
        if str(section.get("label") or "").lower() == "credits":
            amount = parse_amount(section.get("value"))
            if amount:
                remaining = amount[0]
                symbol = amount[1] or symbol
    if remaining is None and funded is not None:
        remaining = max(0.0, funded - (spent or 0.0))
    if remaining is None:
        return None
    return {
        "remaining": round(remaining, 4),
        "funded": round(funded or 0.0, 4),
        "spent": round(spent or 0.0, 4),
        "currency": currency_code(symbol),
    }


def build_record(entry: dict) -> dict:
    vendor = str(entry.get("id") or "").strip()
    record = {
        "schemaVersion": 1,
        "id": vendor,
        "name": str(entry.get("display_name") or entry.get("name") or vendor),
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": False,
        "hasPromptStats": False,
        "scope": "account",
        "tierLabel": str(entry.get("plan") or ""),
        "usageStatusText": "",
        "authHelpText": "",
        "limits": build_limits(entry),
    }
    balance = build_balance(entry)
    if balance:
        record["balance"] = balance
    return record


def collect() -> list:
    binary = find_ai_usagebar()
    if not binary:
        raise SystemExit("ai-usagebar not found on PATH; install it first")
    try:
        proc = subprocess.run(
            [binary, "usage", "--json"],
            capture_output=True, text=True, timeout=60, check=True,
        )
    except subprocess.CalledProcessError as exc:
        raise SystemExit("ai-usagebar failed: " + (exc.stderr.strip() or str(exc)))
    except subprocess.TimeoutExpired:
        raise SystemExit("ai-usagebar timed out")
    records = []
    for entry in json.loads(proc.stdout).get("entries") or []:
        vendor = str(entry.get("id") or "").strip()
        if not vendor or vendor in NATIVE:
            continue
        if entry.get("error") or entry.get("status") != "ready":
            continue
        records.append(build_record(entry))
    return records


def write_records(records: list, directory: Path) -> None:
    directory.mkdir(parents=True, exist_ok=True)
    for record in records:
        handle, tmp = tempfile.mkstemp(dir=str(directory), prefix="." + record["id"] + ".")
        with os.fdopen(handle, "w") as fh:
            json.dump(record, fh, separators=(",", ":"), sort_keys=True)
            fh.write("\n")
        os.replace(tmp, directory / (record["id"] + ".json"))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--write", action="store_true", help="write records into the Omarchy usage directory")
    args = parser.parse_args()
    records = collect()
    if args.write:
        write_records(records, usage_dir())
    else:
        for record in records:
            print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
